# Browser-safe Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Instagram Business Login. Keep the App Secret and token-encryption key server-only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-domain.example/api/admin/instagram/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_GRAPH_API_VERSION=v26.0

# Public browser key for CARTO Voyager map tiles. Restrict its allowed domains in CARTO.
NEXT_PUBLIC_CARTO_API_KEY=

# Server-only key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Legacy PayHero ticket attempts only. New ticket purchases use Paystack.
PAYHERO_AUTH_TOKEN=
PAYHERO_CHANNEL_ID=

# Paystack secret is server-only; its public key may be exposed to the browser.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Keep stable after tickets are issued; base64-encoded 32-byte key.
TICKETING_CREDENTIAL_ENCRYPTION_KEY=

# Canonical public origin used for Paystack callbacks and ticket wallet links.
NEXT_PUBLIC_BASE_URL=https://www.apexmarket.co.ke

# AI provider credentials are server-only; never add NEXT_PUBLIC_ to these names.
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Order notifications: configure only the channels you intend to enable in Admin.
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=Online Bar <orders@your-verified-domain.example>
WHATSAPP_TOKEN=YOUR_META_WHATSAPP_CLOUD_API_TOKEN
WHATSAPP_PHONE_ID=YOUR_META_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_TICKET_TEMPLATE_NAME=ticket_wallet_link
WHATSAPP_TICKET_TEMPLATE_LANGUAGE=en
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+10000000000

# Admin login/session secrets (set privately in the deployment environment).
ADMIN_PASSWORD=SET_A_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=SET_A_DIFFERENT_LONG_RANDOM_SECRET
INTERNAL_API_SECRET=SET_A_DIFFERENT_LONG_RANDOM_SECRET

# Private OSRM HTTP service base URL (for example https://routing.example.com).
# Required in production for road-distance dispatch ranking and delivery route overlays.
OSRM_BASE_URL=

# Use the same PostHog project in Online Bar, Midnight Market, and the Waitlist.
# Session replay starts only after the visitor explicitly opts in.
# See SESSION_REPLAY_SETUP.md for setup and the Online Bar admin link.
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_ID=YOUR_POSTHOG_PROJECT_ID
