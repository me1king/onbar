{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@components/*": [
        "./context/nova-astro-v1.0.0/src/components/*"
      ],
      "@config/*": [
        "./context/nova-astro-v1.0.0/src/config/*"
      ],
      "@data/*": [
        "./context/nova-astro-v1.0.0/src/data/*"
      ],
      "@layouts/*": [
        "./context/nova-astro-v1.0.0/src/layouts/*"
      ],
      "@utils/*": [
        "./context/nova-astro-v1.0.0/src/utils/*"
      ],
      "@styles/*": [
        "./context/nova-astro-v1.0.0/src/styles/*"
      ],
      "@content/*": [
        "./context/nova-astro-v1.0.0/src/content/*"
      ],
      "@lib/*": [
        "./context/nova-astro-v1.0.0/src/lib/*"
      ],
      "@hooks/*": [
        "./context/nova-astro-v1.0.0/src/hooks/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "context/nova-astro-v1.0.0"
  ]
}
