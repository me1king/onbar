]}],[\"$\",\"dl\",null,{\"className\":\"grid gap-4 text-sm sm:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-bold text-slate-500\",\"children\":\"ONBAR legal/business name\"}],[\"$\",\"dd\",null,{\"children\":\"TO BE CONFIRMED\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-bold text-slate-500\",\"children\":\"Registration number\"}],[\"$\",\"dd\",null,{\"children\":\"TO BE CONFIRMED\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-bold text-slate-500\",\"children\":\"Business address\"}],[\"$\",\"dd\",null,{\"children\":\"TO BE CONFIRMED\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-bold text-slate-500\",\"children\":\"Official legal notices email\"}],[\"$\",\"dd\",null,{\"children\":\"TO BE CONFIRMED\"}]]}]]}]]}]\n16:[\"$\",\"section\",null,{\"aria-label\":\"Agreement terms\",\"className\":\"space-y-4\",\"children\":[[\"$\",\"section\",\"1. Purpose of the Agreement\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"1. Purpose of the Agreement\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"ONBAR operates a digital commerce platform and may operate an affiliate and partner programme. Approved partners may promote ONBAR using approved referral methods and may earn commission on completed, verified qualifying sales.\",{\"children\":\"ONBAR operates a digital commerce platform and may operate an affiliate and partner programme. Approved partners may promote ONBAR using approved referral methods and may earn commission on completed, verified qualifying sales.\"}],[\"$\",\"p\",\"This draft explains referral tracking, commission eligibility, payouts, dashboard information, partner responsibilities, prohibited activity, termination, confidentiality and personal-data handling.\",{\"children\":\"This draft explains referral tracking, commission eligibility, payouts, dashboard information, partner responsibilities, prohibited activity, termination, confidentiality and personal-data handling.\"}]]}]]}],[\"$\",\"section\",\"2. Independent Partner Relationship\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"2. Independent Partner Relationship\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The Affiliate is an independent partner, not an employee, agent, franchisee or legal representative of ONBAR. Nothing in this Agreement creates an employment relationship, partnership, joint venture or authority to bind ONBAR.\",{\"children\":\"The Affiliate is an independent partner, not an employee, agent, franchisee or legal representative of ONBAR. Nothing in this Agreement creates an employment relationship, partnership, joint venture or authority to bind ONBAR.\"}],[\"$\",\"p\",\"The Affiliate must not describe themselves as an ONBAR employee, director, owner, spokesperson or authorized representative unless ONBAR expressly authorizes this in writing. The Affiliate is responsible for their own taxes, expenses, equipment, advertising and internet costs.\",{\"children\":\"The Affiliate must not describe themselves as an ONBAR employee, director, owner, spokesperson or authorized representative unless ONBAR expressly authorizes this in writing. The Affiliate is responsible for their own taxes, expenses, equipment, advertising and internet costs.\"}]]}]]}],[\"$\",\"section\",\"3. Affiliate Account\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"3. Affiliate Account\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Approved Affiliates receive an Affiliate Account. Depending on technical availability, it may show a unique referral link and code, referral statistics, qualifying sales, pending, approved, rejected, reversed and paid commissions, payout history and other programme information.\",{\"children\":\"Approved Affiliates receive an Affiliate Account. Depending on technical availability, it may show a unique referral link and code, referral statistics, qualifying sales, pending, approved, rejected, reversed and paid commissions, payout history and other programme information.\"}],\"$L1b\"]}]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\"]}]\n17:[\"$\",\"footer\",null,{\"className\":\"rounded-2xl bg-slate-900 p-6 text-sm leading-6 text-white\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-bold\",\"children\":\"Programme details currently reflected in the product\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-slate-300\",\"children\":\"Default commission rate: 5% (the Affiliate Account’s approved rate controls). Minimum payout request: KSh 1,000. Payout requests are reviewed manually. These details remain subject to the final written programme rules.\"}]]}]\n18:[\"$\",\"$L37\",null,{\"children\":[\"$L38\",[\"$\",\"$L39\",null,{\"promise\":\"$@3a\"}]]}]\n19:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L3b\",null,{\"children\":\"$L3c\"}],null],[\"$\",\"$L3d\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$a\",null,{\"fallback\":null,\"children\":\"$L3e\"}]}]}]]}]\n1b:[\"$\",\"p\",\"The Affiliate must keep account credentials confidential and must not allow another person to operate the account without ONBAR’s written approval.\",{\"children\":\"The Affiliate must keep account credentials confidential and must not allow another person to operate the account without ONBAR’s written approval.\"}]\n1c:[\"$\",\"section\",\"4. Referral Tracking\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"4. Referral Tracking\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"ONBAR will provide one or more unique tracking mechanisms. The system will associate eligible customer activity with an Affiliate according to the programme attribution rules. Dashboard reporting depends on technical availability.\",{\"children\":\"ONBAR will provide one or more unique tracking mechanisms. The system will associate eligible customer activity with an Affiliate according to the programme attribution rules. Dashboard reporting depends on technical availability.\"}],[\"$\",\"p\",\"Affiliate ID, referral link and referral code are issued to the Affiliate after approval. ONBAR’s records are the primary source for referral attribution, subject to the dispute process in this Agreement.\",{\"children\":\"Affiliate ID, referral link and referral code are issued to the Affiliate after approval. ONBAR’s records are the primary source for referral attribution, subject to the dispute process in this Agreement.\"}]]}]]}]\n1d:[\"$\",\"section\",\"5. Commission\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"5. Commission\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Commission is payable only for a qualifying referral that results in a completed and verified sale. The current default commission rate is 5% of attributed completed order value; an approved Affiliate’s actual rate is the rate shown in their Affiliate Account or separately confirmed by ONBAR.\",{\"children\":\"Commission is payable only for a qualifying referral that results in a completed and verified sale. The current default commission rate is 5% of attributed completed order value; an approved Affiliate’s actual rate is the rate shown in their Affiliate Account or separately confirmed by ONBAR.\"}],[\"$\",\"p\",\"Commission is earned only after the transaction is completed and verified and is no longer subject to cancellation, refund, chargeback, fraud investigation or another reversal.\",{\"children\":\"Commission is earned only after the transaction is completed and verified and is no longer subject to cancellation, refund, chargeback, fraud investigation or another reversal.\"}]]}]]}]\n1e:[\"$\",\"section\",\"6. Qualifying Sale\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"6. Qualifying Sale\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"A Qualifying Sale must originate through a valid Affiliate referral mechanism, be completed and verified by ONBAR, be non-fraudulent, not be a prohibited self-referral, remain uncancelled and unreversed, and satisfy the programme rules.\",{\"children\":\"A Qualifying Sale must originate through a valid Affiliate referral mechanism, be completed and verified by ONBAR, be non-fraudulent, not be a prohibited self-referral, remain uncancelled and unreversed, and satisfy the programme rules.\"}],[\"$\",\"p\",\"No commission is owed for a transaction that is cancelled, refunded, reversed, fraudulent or otherwise ineligible.\",{\"children\":\"No commission is owed for a transaction that is cancelled, refunded, reversed, fraudulent or otherwise ineligible.\"}]]}]]}]\n1f:[\"$\",\"section\",\"7. Referral Attribution\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"7. Referral Attribution\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Proposed attribution model: last valid Affiliate referral. The attribution window is TO BE CONFIRMED and must be finalized in the Affiliate Programme rules before partner activation.\",{\"children\":\"Proposed attribution model: last valid Affiliate referral. The attribution window is TO BE CONFIRMED and must be finalized in the Affiliate Programme rules before partner activation.\"}],[\"$\",\"p\",\"Where a customer interacts with multiple Affiliate links, ONBAR’s recorded attribution system determines credit under the applicable model. System records are primary evidence, subject to the dispute process.\",{\"children\":\"Where a customer interacts with multiple Affiliate links, ONBAR’s recorded attribution system determines credit under the applicable model. System records are primary evidence, subject to the dispute process.\"}]]}]]}]\n20:[\"$\",\"section\",\"8. Affiliate Dashboard and Transparency\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"8. Affiliate Dashboard and Transparency\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Where technically available, the Affiliate Dashboard will show referral totals and conversions; qualifying sales, transaction status and reversals; pending, approved, rejected, reversed and paid commissions; available balance, payout threshold, payout history, dates and status.\",{\"children\":\"Where technically available, the Affiliate Dashboard will show referral totals and conversions; qualifying sales, transaction status and reversals; pending, approved, rejected, reversed and paid commissions; available balance, payout threshold, payout history, dates and status.\"}],[\"$\",\"p\",\"The dashboard is intended to help the Affiliate understand referral performance and how commission balances are calculated.\",{\"children\":\"The dashboard is intended to help the Affiliate understand referral performance and how commission balances are calculated.\"}]]}]]}]\n21:[\"$\",\"section\",\"9. Commission Status\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"9. Commission Status\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Pending means a potential commission is still within verification. Approved means qualifying conditions have been met and the commission is available under payout rules. Paid means payment was processed.\",{\"children\":\"Pending means a potential commission is still within verification. Approved means qualifying conditions have been met and the commission is available under payout rules. Paid means payment was processed.\"}],[\"$\",\"p\",\"Reversed means a commission was withdrawn because the underlying transaction became ineligible. Rejected means a referral did not qualify. Where reasonably possible, ONBAR will display the reason for rejection or reversal.\",{\"children\":\"Reversed means a commission was withdrawn because the underlying transaction became ineligible. Rejected means a referral did not qualify. Where reasonably possible, ONBAR will display the reason for rejection or reversal.\"}]]}]]}]\n22:[\"$\",\"section\",\"10. Payouts\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"10. Payouts\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The current minimum payout request is KSh 1,000. Payout requests are reviewed and paid manually; submission does not guarantee or automatically initiate a transfer. Payout timing and frequency are TO BE CONFIRMED and will be communicated in the Affiliate Account or programme rules.\",{\"children\":\"The current minimum payout request is KSh 1,000. Payout requests are reviewed and paid manually; submission does not guarantee or automatically initiate a transfer. Payout timing and frequency are TO BE CONFIRMED and will be communicated in the Affiliate Account or programme rules.\"}],[\"$\",\"p\",\"Approved commissions below the minimum threshold remain in the Affiliate’s balance and may roll over, subject to the final payout rules. For example, an approved balance of KSh 4,500 remains below the KSh 5,000 threshold if that threshold is set for the Affiliate.\",{\"children\":\"Approved commissions below the minimum threshold remain in the Affiliate’s balance and may roll over, subject to the final payout rules. For example, an approved balance of KSh 4,500 remains below the KSh 5,000 threshold if that threshold is set for the Affiliate.\"}]]}]]}]\n23:[\"$\",\"section\",\"11. Payment Records\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"11. Payment Records\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"ONBAR will maintain records of Affiliate commissions and payouts. Commission and payout history will be available through the Affiliate Dashboard where technically available.\",{\"children\":\"ONBAR will maintain records of Affiliate commissions and payouts. Commission and payout history will be available through the Affiliate Dashboard where technically available.\"}],[\"$\",\"p\",\"Where a payout is processed, ONBAR will provide a payment reference or other reasonable confirmation where available.\",{\"children\":\"Where a payout is processed, ONBAR will provide a payment reference or other reasonable confirmation where available.\"}]]}]]}]\n24:[\"$\",\"section\",\"12. Commission Disputes\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"12. Commission Disputes\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"An Affiliate who believes a referral or commission was recorded incorrectly may contact ONBAR through its designated support channel. Include the referral ID, transaction reference where available, relevant date and a description of the issue.\",{\"children\":\"An Affiliate who believes a referral or commission was recorded incorrectly may contact ONBAR through its designated support channel. Include the referral ID, transaction reference where available, relevant date and a description of the issue.\"}],[\"$\",\"p\",\"ONBAR will investigate using available records. Where an error is identified, ONBAR will correct the balance or provide an explanation.\",{\"children\":\"ONBAR will investigate using available records. Where an error is identified, ONBAR will correct the balance or provide an explanation.\"}]]}]]}]\n25:[\"$\",\"section\",\"13. Prohibited Activities\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"13. Prohibited Activities\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The Affiliate must not create fraudulent sales or fake customer accounts; use bots or automation to generate artificial referrals; manipulate cookies, tracking or attribution; make false claims, impersonate ONBAR, make unauthorized promises, advertise deceptively, spam customers or market unlawfully.\",{\"children\":\"The Affiliate must not create fraudulent sales or fake customer accounts; use bots or automation to generate artificial referrals; manipulate cookies, tracking or attribution; make false claims, impersonate ONBAR, make unauthorized promises, advertise deceptively, spam customers or market unlawfully.\"}],[\"$\",\"p\",\"The Affiliate must not access another Affiliate’s account, interfere with ONBAR systems, exploit vulnerabilities or otherwise manipulate the programme. ONBAR may suspend an account while investigating suspected abuse.\",{\"children\":\"The Affiliate must not access another Affiliate’s account, interfere with ONBAR systems, exploit vulnerabilities or otherwise manipulate the programme. ONBAR may suspend an account while investigating suspected abuse.\"}]]}]]}]\n26:[\"$\",\"section\",\"14. Self-Referrals\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"14. Self-Referrals\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Unless ONBAR expressly permits otherwise, Affiliates may not earn commission by referring themselves, their own accounts, or transactions primarily created to earn commission. ONBAR may reverse commissions from prohibited self-referrals.\",{\"children\":\"Unless ONBAR expressly permits otherwise, Affiliates may not earn commission by referring themselves, their own accounts, or transactions primarily created to earn commission. ONBAR may reverse commissions from prohibited self-referrals.\"}]]}]]}]\n27:[\"$\",\"section\",\"15. Marketing Materials\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"15. Marketing Materials\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"ONBAR may provide approved images, logos, banners, referral links, descriptions and other marketing materials. The Affiliate may use these only in accordance with ONBAR’s instructions.\",{\"children\":\"ONBAR may provide approved images, logos, banners, referral links, descriptions and other marketing materials. The Affiliate may use these only in accordance with ONBAR’s instructions.\"}],[\"$\",\"p\",\"The Affiliate must not alter ONBAR branding in a way that could confuse people about the relationship between ONBAR and the Affiliate.\",{\"children\":\"The Affiliate must not alter ONBAR branding in a way that could confuse people about the relationship between ONBAR and the Affiliate.\"}]]}]]}]\n28:[\"$\",\"section\",\"16. Intellectual Property\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"16. Intellectual Property\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"ONBAR or its licensors retain ownership of their intellectual property, including software, trademarks, logos, designs, graphics, databases, website content, documentation, proprietary systems and analytics.\",{\"children\":\"ONBAR or its licensors retain ownership of their intellectual property, including software, trademarks, logos, designs, graphics, databases, website content, documentation, proprietary systems and analytics.\"}],[\"$\",\"p\",\"Participation in the programme does not transfer ownership of ONBAR intellectual property to the Affiliate.\",{\"children\":\"Participation in the programme does not transfer ownership of ONBAR intellectual property to the Affiliate.\"}]]}]]}]\n29:[\"$\",\"section\",\"17. Confidentiality\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"17. Confidentiality\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The Affiliate must protect confidential information obtained through the programme, including non-public commission structures, business and customer information, technical and security information, internal analytics, unreleased features and marketing strategies.\",{\"children\":\"The Affiliate must protect confidential information obtained through the programme, including non-public commission structures, business and customer information, technical and security information, internal analytics, unreleased features and marketing strategies.\"}],[\"$\",\"p\",\"Confidential information must not be disclosed to an unauthorized third party.\",{\"children\":\"Confidential information must not be disclosed to an unauthorized third party.\"}]]}]]}]\n2a:[\"$\",\"section\",\"18. Customer and Personal Data\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"18. Customer and Personal Data\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The Affiliate may collect or process personal information only where legally permitted and supported by an appropriate lawful basis. The Affiliate must not request, sell, publish or misuse customer information for participation in the programme.\",{\"children\":\"The Affiliate may collect or process personal information only where legally permitted and supported by an appropriate lawful basis. The Affiliate must not request, sell, publish or misuse customer information for participation in the programme.\"}],[\"$\",\"p\",\"ONBAR should provide only information reasonably needed to understand performance, such as referral identifiers, counts, conversion status and commission, rather than unnecessary customer personal information. Both parties must comply with applicable Kenyan data-protection requirements, including purpose limitation, transparency and data minimisation.\",{\"children\":\"ONBAR should provide only information reasonably needed to understand performance, such as referral identifiers, counts, conversion status and commission, rather than unnecessary customer personal information. Both parties must comply with applicable Kenyan data-protection requirements, including purpose limitation, transparency and data minimisation.\"}]]}]]}]\n2b:[\"$\",\"section\",\"19. Compliance with Law\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"19. Compliance with Law\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The Affiliate must comply with applicable laws, regulations and programme rules, and must not use the programme for unlawful, deceptive, fraudulent or misleading activity.\",{\"children\":\"The Affiliate must comply with applicable laws, regulations and programme rules, and must not use the programme for unlawful, deceptive, fraudulent or misleading activity.\"}],[\"$\",\"p\",\"Where promoted products or services are subject to advertising, age, licensing or other legal requirements, the Affiliate must comply. ONBAR may impose additional reasonable restrictions for legal or regulatory compliance.\",{\"children\":\"Where promoted products or services are subject to advertising, age, licensing or other legal requirements, the Affiliate must comply. ONBAR may impose additional reasonable restrictions for legal or regulatory compliance.\"}]]}]]}]\n2c:[\"$\",\"section\",\"20. Suspension\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"20. Suspension\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"ONBAR may temporarily suspend an Affiliate Account where it reasonably suspects fraud, abuse, tracking manipulation, security violations, unlawful conduct, a serious breach or material risk to ONBAR or its customers. Where reasonably appropriate, ONBAR will explain the reason.\",{\"children\":\"ONBAR may temporarily suspend an Affiliate Account where it reasonably suspects fraud, abuse, tracking manipulation, security violations, unlawful conduct, a serious breach or material risk to ONBAR or its customers. Where reasonably appropriate, ONBAR will explain the reason.\"}],[\"$\",\"p\",\"Suspension does not automatically forfeit legitimately earned commissions. Final treatment of disputed commissions depends on investigation results and applicable law.\",{\"children\":\"Suspension does not automatically forfeit legitimately earned commissions. Final treatment of disputed commissions depends on investigation results and applicable law.\"}]]}]]}]\n2d:[\"$\",\"section\",\"21. Termination\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"21. Termination\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Either party may terminate on written notice. The notice period is TO BE CONFIRMED in the final programme rules.\",{\"children\":\"Either party may terminate on written notice. The notice period is TO BE CONFIRMED in the final programme rules.\"}],[\"$\",\"p\",\"ONBAR may terminate immediately for serious fraud, intentional programme manipulation, a serious confidentiality breach, unlawful access to ONBAR systems, impersonation or serious unlawful conduct. Where a breach can be corrected, ONBAR may allow a reasonable time to remedy it.\",{\"children\":\"ONBAR may terminate immediately for serious fraud, intentional programme manipulation, a serious confidentiality breach, unlawful access to ONBAR systems, impersonation or serious unlawful conduct. Where a breach can be corrected, ONBAR may allow a reasonable time to remedy it.\"}]]}]]}]\n2e:[\"$\",\"section\",\"22. Commissions After Termination\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"22. Commissions After Termination\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Termination does not automatically eliminate commissions legitimately earned before termination. Subject to verification, refunds, chargebacks, fraud investigations and programme rules, qualifying pre-termination commissions remain payable through the normal payout process.\",{\"children\":\"Termination does not automatically eliminate commissions legitimately earned before termination. Subject to verification, refunds, chargebacks, fraud investigations and programme rules, qualifying pre-termination commissions remain payable through the normal payout process.\"}],[\"$\",\"p\",\"After termination, the Affiliate must stop using referral links, promotional materials and ONBAR branding unless ONBAR gives written permission.\",{\"children\":\"After termination, the Affiliate must stop using referral links, promotional materials and ONBAR branding unless ONBAR gives written permission.\"}]]}]]}]\n2f:[\"$\",\"section\",\"23. Limitation of Authority\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"23. Limitation of Authority\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The Affiliate must not enter contracts or make legal commitments on behalf of ONBAR, promise unapproved refunds or benefits, represent themselves as an ONBAR employee, or materially misrepresent ONBAR products, services or policies.\",{\"children\":\"The Affiliate must not enter contracts or make legal commitments on behalf of ONBAR, promise unapproved refunds or benefits, represent themselves as an ONBAR employee, or materially misrepresent ONBAR products, services or policies.\"}]]}]]}]\n30:[\"$\",\"section\",\"24. Changes to the Affiliate Programme\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"24. Changes to the Affiliate Programme\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"ONBAR may reasonably change commission rates, qualifying conditions, attribution rules, payout schedules, minimum thresholds and programme policies. Material changes affecting future commissions will be notified through the Affiliate Dashboard, email or another designated channel.\",{\"children\":\"ONBAR may reasonably change commission rates, qualifying conditions, attribution rules, payout schedules, minimum thresholds and programme policies. Material changes affecting future commissions will be notified through the Affiliate Dashboard, email or another designated channel.\"}],[\"$\",\"p\",\"Unless required by law or necessary to correct fraud or error, a change will not retroactively remove commissions validly earned under prior terms.\",{\"children\":\"Unless required by law or necessary to correct fraud or error, a change will not retroactively remove commissions validly earned under prior terms.\"}]]}]]}]\n31:[\"$\",\"section\",\"25. System Availability\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"25. System Availability\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"ONBAR will make reasonable efforts to maintain the Affiliate Dashboard and tracking systems. Temporary interruptions may result from maintenance, third-party failures, network problems, security incidents, software updates or events outside ONBAR’s reasonable control.\",{\"children\":\"ONBAR will make reasonable efforts to maintain the Affiliate Dashboard and tracking systems. Temporary interruptions may result from maintenance, third-party failures, network problems, security incidents, software updates or events outside ONBAR’s reasonable control.\"}],[\"$\",\"p\",\"Temporary unavailability does not automatically create a right to compensation.\",{\"children\":\"Temporary unavailability does not automatically create a right to compensation.\"}]]}]]}]\n32:[\"$\",\"section\",\"26. Taxes\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"26. Taxes\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Each party is responsible for applicable tax obligations arising from programme participation. Where ONBAR is legally required to withhold or report taxes on Affiliate payments, it may do so in accordance with applicable law and provide required documentation.\",{\"children\":\"Each party is responsible for applicable tax obligations arising from programme participation. Where ONBAR is legally required to withhold or report taxes on Affiliate payments, it may do so in accordance with applicable law and provide required documentation.\"}]]}]]}]\n33:[\"$\",\"section\",\"27. Dispute Resolution and Governing Law\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"27. Dispute Resolution and Governing Law\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The parties will first attempt to resolve disputes through good-faith discussion. They may use an appropriate alternative dispute-resolution process before court proceedings where required or appropriate.\",{\"children\":\"The parties will first attempt to resolve disputes through good-faith discussion. They may use an appropriate alternative dispute-resolution process before court proceedings where required or appropriate.\"}],[\"$\",\"p\",\"The governing-law and dispute-resolution terms are TO BE CONFIRMED and reviewed by a Kenyan advocate before this draft is adopted as a final commercial agreement.\",{\"children\":\"The governing-law and dispute-resolution terms are TO BE CONFIRMED and reviewed by a Kenyan advocate before this draft is adopted as a final commercial agreement.\"}]]}]]}]\n34:[\"$\",\"section\",\"28. Notices\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"28. Notices\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"Official notices may be delivered by email, through the Affiliate Dashboard or by another agreed method. The Affiliate is responsible for keeping contact information up to date.\",{\"children\":\"Official notices may be delivered by email, through the Affiliate Dashboard or by another agreed method. The Affiliate is responsible for keeping contact information up to date.\"}]]}]]}]\n35:[\"$\",\"section\",\"29. Entire Agreement\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"29. Entire Agreement\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"This Agreement, together with applicable Affiliate Programme Rules and documents expressly incorporated into it, represents the parties’ understanding of the programme. Amendments must follow the amendment provisions above.\",{\"children\":\"This Agreement, together with applicable Affiliate Programme Rules and documents expressly incorporated into it, represents the parties’ understanding of the programme. Amendments must follow the amendment provisions above.\"}]]}]]}]\n36:[\"$\",\"section\",\"30. Acceptance and Signatures\",{\"className\":\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold sm:text-xl\",\"children\":\"30. Acceptance and Signatures\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-3 text-sm leading-7 text-slate-600 sm:text-base\",\"children\":[[\"$\",\"p\",\"The application checkbox acknowledges this draft and the current programme rules; it does not replace a final signed agreement. Before commercial activation, the parties must confirm the outstanding details listed above and complete any required final acceptance.\",{\"children\":\"The application checkbox acknowledges this draft and the current programme rules; it does not replace a final signed agreement. Before commercial activation, the parties must confirm the outstanding details listed above and complete any required final acceptance.\"}]]}]]}]\n3c:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1, viewport-fit=cover\"}]]\n38:null\n3f:I[80622,[],\"IconMark\"]\n3a:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Affiliate & Partner Agreement | Online Bar | Online Bar\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Draft terms for the Online Bar affiliate and partner programme.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"robots\",\"content\":\"noindex, nofollow, noarchive\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"Alcohol Delivery in Nairobi | Online Bar\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"Online ordering is open 24/7. Eligible local Nairobi delivery is estimated at 10–30 minutes, subject to address and availability. Confirm coverage and timing at checkout.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:site_name\",\"content\":\"Online Bar\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:locale\",\"content\":\"en_KE\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"Alcohol Delivery in Nairobi | Online Bar\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:description\",\"content\":\"Online ordering is open 24/7. Eligible local Nairobi delivery is estimated at 10–30 minutes, subject to address and availability. Confirm coverage and timing at checkout.\"}],[\"$\",\"link\",\"12\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"13\",{\"rel\":\"apple-touch-icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"$L3f\",\"14\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n3e:\"$3a:metadata\"\n"}